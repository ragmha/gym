{
  "expo": {
    "name": "gym",
    "slug": "gym",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "io.raghib.gym",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.raghib.gym",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.raghib.gym",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "This app reads your activity, sleep, heart metrics, weight, hydration, and nutrition data from Apple Health to display your daily dashboard.",
          "NSHealthUpdateUsageDescription": "Save the water amount you explicitly confirm, the body weight and measurement time you enter and explicitly confirm, and the meal calories, protein, carbohydrates, and fat from a photo that you explicitly confirm to Apple Health."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a meal photo so this device can estimate its calories. The photo is not saved.",
          "photosPermission": "Choose a meal photo so this device can estimate its calories. The photo is not saved.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Record your practice talk so you can review it and choose whether to share it.",
          "microphonePermission": "Hear your practice talk so it can be transcribed on this device.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hear your practice talk so it can be transcribed on this device.",
          "speechRecognitionPermission": "Turn your practice talk into a transcript on this device."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "io.raghib.gym.ExpoWidgetsTarget",
          "groupIdentifier": "group.io.raghib.gym"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "be33becb-fe1c-448c-adc5-1f2a961d8045"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/be33becb-fe1c-448c-adc5-1f2a961d8045"
    }
  }
}
