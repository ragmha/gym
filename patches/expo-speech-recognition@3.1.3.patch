+  /// Streams a movie's first audio track as PCM, pausing once per 4096 frames like the AVAudioFile path.
+  private static func appendMovieAudio(
+    from url: URL,
+    to request: SFSpeechAudioBufferRecognitionRequest,
+    chunkDelayNs: UInt64
+  ) async throws {
+    let asset = AVURLAsset(url: url)
+    guard let track = try await asset.loadTracks(withMediaType: .audio).first else {
+      throw RecognizerError.invalidAudioSource
+    }
+    let reader = try AVAssetReader(asset: asset)
+    let output = AVAssetReaderTrackOutput(
+      track: track,
+      outputSettings: [
+        AVFormatIDKey: kAudioFormatLinearPCM,
+        AVLinearPCMBitDepthKey: 32,
+        AVLinearPCMIsFloatKey: true,
+        AVLinearPCMIsNonInterleaved: true,
+        AVLinearPCMIsBigEndianKey: false,
+      ]
+    )
+    reader.add(output)
+    guard reader.startReading() else {
+      throw reader.error ?? RecognizerError.invalidAudioSource
+    }
+
+    var framesSinceDelay: AVAudioFrameCount = 0
+    while let sampleBuffer = output.copyNextSampleBuffer() {
+      let frames = AVAudioFrameCount(sampleBuffer.numSamples)
+      guard frames > 0, let description = sampleBuffer.formatDescription,
+        let buffer = AVAudioPCMBuffer(
+          pcmFormat: AVAudioFormat(cmAudioFormatDescription: description), frameCapacity: frames)
+      else { continue }
+      buffer.frameLength = frames
+      try sampleBuffer.copyPCMData(fromRange: 0..<Int(frames), into: buffer.mutableAudioBufferList)
+      request.append(buffer)
+      framesSinceDelay += frames
+      if framesSinceDelay >= 4096 {
+        framesSinceDelay = 0
+        try await Task.sleep(nanoseconds: chunkDelayNs)
+      }
+    }
+    if reader.status == .failed {
+      throw reader.error ?? RecognizerError.invalidAudioSource
+    }
+  }
